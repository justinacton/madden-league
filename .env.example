# Copy this file to .env for local development.
# Never commit real values.

# Set to "true" to run the entire site on bundled mock data with no Sanity
# project required. Set to "false" (or remove) to read from Sanity.
USE_MOCK_DATA=false

# Sanity project ID and dataset (see studio/ for the schema/Studio app).
# Reads are unauthenticated — no token needed here; the site only reads
# published documents from a public dataset.
SANITY_PROJECT_ID=xxxxxxxx
SANITY_DATASET=production

# --- Legacy: Airtable (superseded by Sanity, kept for reference/rollback) ---
# AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
# AIRTABLE_API_URL=https://api.airtable.com/v0
