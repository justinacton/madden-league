# Copy this file to .env for local development.
# Never commit an actual token.

# Set to "true" to run the entire site on bundled mock data with no Airtable
# credentials required. Set to "false" (or remove) to read from Airtable.
USE_MOCK_DATA=true

# Airtable Personal Access Token with read-only access to only the league base.
# See README.md "How to create a read-only Airtable Personal Access Token".
AIRTABLE_TOKEN=

# The Airtable base ID, e.g. appXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=

# Airtable REST API root. Only change this if Airtable's API host changes.
AIRTABLE_API_URL=https://api.airtable.com/v0
