---
import { formatAverage, formatSignedNumber, formatWinPercentage } from '../../lib/formatting';
import type { ManagerCareerSummary, ManagerStatsEntry } from '../../lib/types';

interface Props {
  mode: 'season' | 'career';
  seasonRows?: ManagerStatsEntry[];
  careerRows?: ManagerCareerSummary[];
}

const { mode, seasonRows = [], careerRows = [] } = Astro.props;
const rankedSeasonRows = [...seasonRows]
  .sort((a, b) => b.wins - a.wins || b.winPercentage - a.winPercentage)
  .map((row, index) => ({ ...row, rank: index + 1 }));
const rankedCareerRows = [...careerRows]
  .sort((a, b) => b.careerWins - a.careerWins || b.careerWinPercentage - a.careerWinPercentage)
  .map((row, index) => ({ ...row, rank: index + 1 }));
---
{mode === 'season' ? (
  rankedSeasonRows.length === 0 ? (
    <p class="empty-state">No manager statistics have been entered for this season yet.</p>
  ) : (
    <div class="table-scroll">
      <table class="data-table responsive-cards" data-sortable>
        <thead>
          <tr>
            <th scope="col" data-sort-key="rank" data-sort-type="numeric" aria-sort="ascending">Rank</th>
            <th scope="col">Manager</th>
            <th scope="col" class="team-cell">Team</th>
            <th scope="col" class="numeric" data-sort-key="wins" data-sort-type="numeric">W</th>
            <th scope="col" class="numeric" data-sort-key="losses" data-sort-type="numeric">L</th>
            <th scope="col" class="numeric" data-sort-key="winpct" data-sort-type="numeric">Win%</th>
            <th scope="col" class="numeric" data-sort-key="ppg" data-sort-type="numeric">PPG</th>
            <th scope="col" class="numeric" data-sort-key="papg" data-sort-type="numeric">PAPG</th>
            <th scope="col" class="numeric" data-sort-key="diff" data-sort-type="numeric">Diff</th>
            <th scope="col" class="numeric" data-sort-key="to" data-sort-type="numeric">TO</th>
            <th scope="col" class="numeric" data-sort-key="ta" data-sort-type="numeric">TA</th>
          </tr>
        </thead>
        <tbody>
          {rankedSeasonRows.map((row) => (
            <tr class:list={{ 'top-three': row.rank <= 3 }}>
              <td data-label="Rank">{row.rank}</td>
              <td data-label="Manager"><a href={`/managers/${row.manager.slug}`}>{row.manager.name}</a></td>
              <td data-label="Team" class="team-cell">
                <a class="team-link" href={`/teams/${row.team.slug}`}>
                  <img class="team-logo-sm" src={row.team.logoUrl} alt="" loading="lazy" />
                  {row.team.abbreviation}
                </a>
              </td>
              <td data-label="Wins" class="numeric">{row.wins}</td>
              <td data-label="Losses" class="numeric">{row.losses}</td>
              <td data-label="Win %" class="numeric" data-sort-value={row.winPercentage}>{formatWinPercentage(row.winPercentage)}</td>
              <td data-label="Points Per Game" class="numeric" data-sort-value={row.pointsPerGame}>{formatAverage(row.pointsPerGame)}</td>
              <td data-label="Points Allowed Per Game" class="numeric" data-sort-value={row.pointsAllowedPerGame}>{formatAverage(row.pointsAllowedPerGame)}</td>
              <td data-label="Point Differential" class="numeric" data-sort-value={row.pointDifferential}>{formatSignedNumber(row.pointDifferential)}</td>
              <td data-label="Turnovers" class="numeric">{row.turnovers}</td>
              <td data-label="Takeaways" class="numeric">{row.takeaways}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
) : rankedCareerRows.length === 0 ? (
  <p class="empty-state">No career statistics are available yet.</p>
) : (
  <div class="table-scroll">
    <table class="data-table responsive-cards" data-sortable>
      <thead>
        <tr>
          <th scope="col" data-sort-key="rank" data-sort-type="numeric" aria-sort="ascending">Rank</th>
          <th scope="col">Manager</th>
          <th scope="col" class="team-cell">Current Team</th>
          <th scope="col" class="numeric" data-sort-key="wins" data-sort-type="numeric">W</th>
          <th scope="col" class="numeric" data-sort-key="losses" data-sort-type="numeric">L</th>
          <th scope="col" class="numeric" data-sort-key="ties" data-sort-type="numeric">T</th>
          <th scope="col" class="numeric" data-sort-key="winpct" data-sort-type="numeric">Win%</th>
          <th scope="col" class="numeric" data-sort-key="playoff" data-sort-type="numeric">Playoff W-L</th>
          <th scope="col" class="numeric" data-sort-key="championships" data-sort-type="numeric">Titles</th>
          <th scope="col" class="numeric" data-sort-key="seasons" data-sort-type="numeric">Seasons</th>
        </tr>
      </thead>
      <tbody>
        {rankedCareerRows.map((row) => (
          <tr class:list={{ 'top-three': row.rank <= 3 }}>
            <td data-label="Rank">{row.rank}</td>
            <td data-label="Manager"><a href={`/managers/${row.slug}`}>{row.displayName}</a></td>
            <td data-label="Current Team" class="team-cell">
              {row.currentTeam ? (
                <a class="team-link" href={`/teams/${row.currentTeam.slug}`}>
                  <img class="team-logo-sm" src={row.currentTeam.logoUrl} alt="" loading="lazy" />
                  {row.currentTeam.abbreviation}
                </a>
              ) : '-'}
            </td>
            <td data-label="Wins" class="numeric">{row.careerWins}</td>
            <td data-label="Losses" class="numeric">{row.careerLosses}</td>
            <td data-label="Ties" class="numeric">{row.careerTies}</td>
            <td data-label="Win %" class="numeric" data-sort-value={row.careerWinPercentage}>{formatWinPercentage(row.careerWinPercentage)}</td>
            <td data-label="Playoff Record" class="numeric" data-sort-value={row.careerPlayoffWins}>{row.careerPlayoffWins}-{row.careerPlayoffLosses}</td>
            <td data-label="Championships" class="numeric">{row.championships}</td>
            <td data-label="Seasons Played" class="numeric">{row.seasonsPlayed}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
